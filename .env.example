# URL pública HTTPS (sem barra final). O endpoint MCP fica em ${PUBLIC_URL}/mcp
PUBLIC_URL=https://colibri.celestiaflights.com

# Contas Google autorizadas (separadas por vírgula). Qualquer outra conta recebe 401.
OWNER_EMAILS=voce@gmail.com

# OAuth client "Web application" criado no Google Cloud Console.
# Redirect URI autorizado: ${PUBLIC_URL}/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chave do aplicativo registrado no Colibri Cloud
# (Usuários e lojas > Aplicativos registrados > Criar aplicativo)
COLIBRI_CLIENT_ID=
# Host atual da API (o cloud.ncrcolibri.com.br da documentação não existe mais no DNS)
COLIBRI_BASE_URL=https://cloud.colibricloud.com

# Opcionais
COLIBRI_ALLOW_WRITES=false
COLIBRI_MAX_PAGINAS=50
# Bearer fixo para clientes sem OAuth (n8n, scripts). Gere com: openssl rand -hex 32
MCP_STATIC_TOKEN=
# Chave própria para assinar os tokens emitidos (se vazio, deriva do GOOGLE_CLIENT_SECRET)
JWT_SIGNING_KEY=
MCP_PATH=/mcp
